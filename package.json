{
  "name": "bela-donzela-api",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "start": "prisma db push --skip-generate || echo db-push-falhou && node src/server.js",
    "dev": "node --watch src/server.js",
    "setup": "prisma generate && prisma db push && node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "smoke": "node scripts/smoke.js",
    "encrypt-existing": "node scripts/encrypt-existing.js"
  },
  "dependencies": {
    "prisma": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "zod": "^3.23.8"
  }
}
