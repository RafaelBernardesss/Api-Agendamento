generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  durationMinutes Int         @default(60)
  appointments Appointment[]
  appointmentServices AppointmentService[]
}

model Appointment {
  id         Int      @id @default(autoincrement())
  clientName String
  phone      String
  date       String
  time       String

  durationMinutes Int @default(60)

  status     String   @default("CONFIRMED")
  rejectReason String?
  reminderSentAt DateTime?
  presence       String?
  presenceReason String?
  presenceAt     DateTime?
  slotKey    String?  @unique

  service    Service  @relation(fields: [serviceId], references: [id])
  serviceId  Int
  services   AppointmentService[]
  createdAt  DateTime @default(now())

  @@index([phone])
  @@index([date, time])
}

model AppointmentService {
  id            Int         @id @default(autoincrement())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId Int
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceId     Int

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  phone     String
  title     String
  message   String
  kind      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model BlockedDay {
  id     Int     @id @default(autoincrement())
  date   String  @unique
  reason String?
}

model WorkHours {
  weekday    Int     @id
  works      Boolean @default(true)
  open       String  @default("07:00")
  close      String  @default("18:00")
  lunchStart String?
  lunchEnd   String?
}

model DayHours {
  id         Int     @id @default(autoincrement())
  date       String  @unique
  open       String
  close      String
  lunchStart String?
  lunchEnd   String?
}

model DayLimit {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  max       Int
  afterId   Int      @default(0)
  createdAt DateTime @default(now())
}

model Admin {
  id       Int         @id @default(autoincrement())
  username String      @unique
  phone    String
  email    String?
  codes    AdminCode[]
}

model AdminCode {
  id        Int      @id @default(autoincrement())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   Int
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([adminId])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  owner     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([owner])
}
